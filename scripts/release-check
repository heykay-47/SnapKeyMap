#!/usr/bin/env python3
import pathlib
import re
import sys


def main():
    if len(sys.argv) != 1:
        print("Usage: scripts/release-check")
        return 1

    root = pathlib.Path(__file__).resolve().parent.parent
    gradle = (root / "app/build.gradle.kts").read_text(encoding="utf-8")
    version_match = re.search(r'^\s*versionName = "([0-9]+\.[0-9]+\.[0-9]+)"\s*$', gradle, re.MULTILINE)
    code_match = re.search(r'^\s*versionCode = ([0-9]+)\s*$', gradle, re.MULTILINE)
    failures = []
    if not version_match:
        failures.append("app/build.gradle.kts must have a literal major.minor.patch versionName")
    if not code_match:
        failures.append("app/build.gradle.kts must have a literal integer versionCode")
    if not failures:
        version = version_match.group(1)
        code = int(code_match.group(1))
        major, minor, patch = map(int, version.split("."))
        expected = major * 10000 + minor * 100 + patch
        if code != expected:
            failures.append(f"versionCode for {version} must be {expected}, not {code}")

        changelog = pathlib.Path(f"fastlane/metadata/android/en-US/changelogs/{code}.txt")
        if not (root / changelog).is_file():
            failures.append(f"Missing changelog {changelog}")
        else:
            notes = (root / changelog).read_text(encoding="utf-8")
            if not notes.strip():
                failures.append(f"Changelog {changelog} is empty")
            if len(notes) > 500:
                failures.append(f"Changelog {changelog} has {len(notes)} characters, at most 500 allowed")

        heading = f"## Delivered in v{version}"
        roadmap = root / "ROADMAP.md"
        if not roadmap.is_file() or heading not in [
            line.rstrip() for line in roadmap.read_text(encoding="utf-8").splitlines()
        ]:
            failures.append(f"ROADMAP.md is missing heading {heading}")

    if failures:
        print("\n".join(failures))
        return 1
    print(f"Release v{version} ({code}) checks passed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, UnicodeError) as error:
        print(f"Cannot check release files: {error}")
        sys.exit(1)
